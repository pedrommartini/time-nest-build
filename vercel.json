{
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"timenest_v3.1.0.apk\""
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/download",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/pedrommartini/time-nest-build/releases/download/v3.1.0/timenest_v3.1.0.apk",
      "permanent": false
    },
    {
      "source": "/apkdownload",
      "destination": "https://github.com/pedrommartini/time-nest-build/releases/download/v3.1.0/timenest_v3.1.0.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.apk|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
